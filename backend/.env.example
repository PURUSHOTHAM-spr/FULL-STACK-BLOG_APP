# Required application settings
PORT=4000
DB_URL=mongodb://127.0.0.1:27017/blog-app
JWT_SECRET=replace_with_a_long_random_secret

# Required for profile image uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional environment and CORS settings
NODE_ENV=development
# Comma-separated additional exact origins. localhost:5173, 127.0.0.1:5173, and the current
# production Vercel origin are already allowed by the application.
CORS_ORIGINS=http://localhost:5173

# Existing deployments may temporarily use these legacy names instead:
# CLOUD_NAME=your_cloudinary_cloud_name
# API_KEY=your_cloudinary_api_key
# API_SECRET=your_cloudinary_api_secret
